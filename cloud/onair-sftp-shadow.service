[Unit]
Description=ON AIR Resamania SFTP shadow ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/opt/onair-agent
ExecStart=/opt/onair-agent/cloud/run-sftp-shadow.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
